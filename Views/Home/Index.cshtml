@{
    ViewBag.Title = "Inicio";
}

<style>
    /* Reset y estilos base */
    body {
        background-color: #f7f7f7;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }

    .header-blue {
        background-color: #003a8c;
        color: white;
        padding: 1.5rem 0;
        text-align: center;
        font-weight: 700;
        font-size: 2rem;
        letter-spacing: 1px;
        margin-bottom: 2rem;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
    }

    /* Carrusel */
    #hospedajeCarousel {
        position: relative;
        padding: 0 60px; /* espacio a los lados para las flechas */
    }

        #hospedajeCarousel .carousel-item img {
            max-height: 70vh;
            object-fit: cover;
            border-radius: 10px;
        }

        #hospedajeCarousel .carousel-caption {
            background: rgba(0, 0, 0, 0.5);
            border-radius: 10px;
            padding: 1rem 2rem;
            max-width: 600px;
            left: 2rem;
            bottom: 3rem;
            text-align: left;
        }

            #hospedajeCarousel .carousel-caption h1 {
                font-size: 2.5rem;
                font-weight: 800;
                margin-bottom: 0.5rem;
            }

            #hospedajeCarousel .carousel-caption p {
                font-size: 1.25rem;
            }

    /* Controles carrusel con colores personalizados y posición fuera de imagen */
    /* Controles carrusel sin fondo ni círculo, solo flechas blancas */
    .carousel-control-prev,
    .carousel-control-next {
        width: auto;
        padding: 0;
        background-color: transparent !important;
        border-radius: 0;
        opacity: 1;
        top: 50%;
        transform: translateY(-50%);
        position: absolute;
        z-index: 10;
    }

    .carousel-control-prev {
        left: 10px;
    }

    .carousel-control-next {
        right: 10px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-image: none !important;
        filter: invert(1);
        width: 30px;
        height: 30px;
        position: relative;
        display: inline-block;
    }

    .carousel-control-prev,
    .carousel-control-next {
        width: auto;
        padding: 0;
        background-color: transparent !important;
        border-radius: 0;
        opacity: 1;
        top: 50%;
        transform: translateY(-50%);
        position: absolute;
        z-index: 10;
    }

    .carousel-control-prev {
        left: 10px;
    }

    .carousel-control-next {
        right: 10px;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-image: none !important;
        filter: invert(1);
        width: 30px;
        height: 30px;
        position: relative;
        display: inline-block;
    }

        .carousel-control-prev-icon::after,
        .carousel-control-next-icon::after {
            content: '';
            display: inline-block;
            width: 12px;
            height: 12px;
            border-top: 3px solid white;
            border-right: 3px solid white;
            position: absolute;
            top: 50%;
            left: 50%;
        }

        /* Flecha izquierda */
        .carousel-control-prev-icon::after {
            transform: translate(-50%, -50%) rotate(-135deg);
        }

        /* Flecha derecha */
        .carousel-control-next-icon::after {
            transform: translate(-50%, -50%) rotate(45deg);
        }




    /* Tarjetas */
    .card {
        border: none;
        border-radius: 12px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);
        }

    .card-img-top {
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        height: 250px;
        object-fit: cover;
    }

    .card-body {
        background-color: white;
        padding: 1rem 1.25rem;
    }

    .card-title {
        font-weight: 700;
        font-size: 1.25rem;
        color: #222;
    }

    .card-text {
        color: #666;
        font-size: 1rem;
    }

    h2.section-title {
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: #222;
        text-align: center;
    }

    /* Container ajustes */
    .container.my-5 {
        max-width: 1140px;
    }

    /* Para links sin subrayado */
    a.no-underline:hover {
        text-decoration: none;
    }
</style>

<div class="header-blue">
    Encuentra tu lugar ideal
</div>

<div class="container">
    <!-- Carrusel -->
    <div id="hospedajeCarousel" class="carousel slide mb-5" data-ride="carousel" data-interval="5000" data-pause="hover">
        <div class="carousel-inner rounded-4 shadow-lg">
            <div class="carousel-item active">
                <a href="@Url.Action("Detalle", "Hospedaje", new { id = 1 })" class="no-underline">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/49/49/60/20/1200x1200/1802678808.jpg?isFirstImage=true"
                         alt="Hospedaje 1" class="d-block w-100 rounded-4">
                    <div class="carousel-caption d-none d-md-block">
                        <h1>Encuentra tu lugar ideal</h1>
                        <p>Hospedajes únicos en cualquier parte del mundo</p>
                    </div>
                </a>
            </div>

            <div class="carousel-item">
                <a href="@Url.Action("Detalle", "Hospedaje", new { id = 2 })" class="no-underline">
                    <img src="https://complejoclarita.com.ar/wp-content/uploads/casas-frente-al-mar-en-la-costa-atlantica.jpg"
                         alt="Hospedaje 2" class="d-block w-100 rounded-4">
                </a>
            </div>

            <div class="carousel-item">
                <a href="@Url.Action("Detalle", "Hospedaje", new { id = 3 })" class="no-underline">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/55/56/52/03/1200x1200/1959534758.jpg?isFirstImage=true"
                         alt="Hospedaje 3" class="d-block w-100 rounded-4">
                </a>
            </div>
        </div>

        <a class="carousel-control-prev" href="#hospedajeCarousel" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Anterior</span>
        </a>
        <a class="carousel-control-next" href="#hospedajeCarousel" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Siguiente</span>
        </a>
    </div>

    <!-- Tarjetas -->
    <h2 class="section-title">Explora lugares populares</h2>
    <div class="row g-4">
        <div class="col-lg-4 col-md-6">
            <a href="@Url.Action("Detalle", "Hospedaje", new { id = 1 })" style="color: inherit;" class="no-underline">
                <div class="card shadow-sm h-100">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/49/49/60/20/1200x1200/1802678808.jpg?isFirstImage=true"
                         class="card-img-top" alt="Cabaña" />
                    <div class="card-body">
                        <h5 class="card-title">Cabañas en la montaña</h5>
                        <p class="card-text">Naturaleza y tranquilidad.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a href="@Url.Action("Detalle", "Hospedaje", new { id = 2 })" style="color: inherit;" class="no-underline">
                <div class="card shadow-sm h-100">
                    <img src="https://complejoclarita.com.ar/wp-content/uploads/casas-frente-al-mar-en-la-costa-atlantica.jpg"
                         class="card-img-top" alt="Playa" />
                    <div class="card-body">
                        <h5 class="card-title">Casas frente al mar</h5>
                        <p class="card-text">Relajate con vista al océano.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a href="@Url.Action("Detalle", "Hospedaje", new { id = 3 })" style="color: inherit;" class="no-underline">
                <div class="card shadow-sm h-100">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/55/56/52/03/1200x1200/1959534758.jpg?isFirstImage=true"
                         class="card-img-top" alt="Ciudad" />
                    <div class="card-body">
                        <h5 class="card-title">Departamentos en la ciudad</h5>
                        <p class="card-text">Cerca de todo lo que necesitás.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
