@{
    ViewBag.Title = "Inicio";
}

<!-- Fondo azul oscuro -->
<div style="background-color: #0d47a1; min-height: 100vh; padding-bottom: 50px; color: white;">

    <!-- Carrusel de hospedajes -->
    <div class="container-fluid p-0">
        <div id="hospedajeCarousel" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/49/49/60/20/1200x1200/1802678808.jpg?isFirstImage=true"
                         class="d-block w-100"
                         alt="Hospedaje 1"
                         style="max-height: 75vh; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block">
                        <h1 class="display-4 font-weight-bold bg-white text-dark p-2 rounded">Encuentra tu lugar ideal</h1>
                        <p class="lead bg-white text-dark p-2 rounded">Hospedajes únicos en cualquier parte del mundo</p>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="https://complejoclarita.com.ar/wp-content/uploads/casas-frente-al-mar-en-la-costa-atlantica.jpg"
                         class="d-block w-100"
                         alt="Hospedaje 2"
                         style="max-height: 75vh; object-fit: cover;">
                </div>

                <div class="carousel-item">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/55/56/52/03/1200x1200/1959534758.jpg?isFirstImage=true"
                         class="d-block w-100"
                         alt="Hospedaje 3"
                         style="max-height: 75vh; object-fit: cover;">
                </div>
            </div>

            <a class="carousel-control-prev" href="#hospedajeCarousel" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Anterior</span>
            </a>
            <a class="carousel-control-next" href="#hospedajeCarousel" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Siguiente</span>
            </a>
        </div>
    </div>

    <!-- Buscador -->
    <div class="container my-4">
        <input type="text" class="form-control w-100 w-md-75 mx-auto rounded-pill shadow" placeholder="¿A dónde quieres ir?" />
    </div>

    <!-- Tarjetas -->
    <div class="container my-5">
        <h2 class="mb-4 text-white">Explora lugares populares</h2>
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow h-100 border-0">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/49/49/60/20/1200x1200/1802678808.jpg?isFirstImage=true"
                         class="card-img-top" style="height: 250px; object-fit: cover;" alt="Cabaña">
                    <div class="card-body bg-light">
                        <h5 class="card-title text-dark">Cabañas en la montaña</h5>
                        <p class="card-text text-muted">Naturaleza y tranquilidad.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow h-100 border-0">
                    <img src="https://complejoclarita.com.ar/wp-content/uploads/casas-frente-al-mar-en-la-costa-atlantica.jpg"
                         class="card-img-top" style="height: 250px; object-fit: cover;" alt="Playa">
                    <div class="card-body bg-light">
                        <h5 class="card-title text-dark">Casas frente al mar</h5>
                        <p class="card-text text-muted">Relajate con vista al océano.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow h-100 border-0">
                    <img src="https://imgar.zonapropcdn.com/avisos/resize/1/00/55/56/52/03/1200x1200/1959534758.jpg?isFirstImage=true"
                         class="card-img-top" style="height: 250px; object-fit: cover;" alt="Ciudad">
                    <div class="card-body bg-light">
                        <h5 class="card-title text-dark">Departamentos en la ciudad</h5>
                        <p class="card-text text-muted">Cerca de todo lo que necesitás.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
