@{
    var currentController = ViewContext.RouteData.Values["controller"].ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
    <div class="container">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
            <img src="https://upload.wikimedia.org/wikipedia/commons/6/69/Airbnb_Logo_Bélo.svg" alt="Logo" class="d-inline-block align-top mr-2" style="height: 40px;" />
            <strong>MiAirbnb</strong>
        </a>

        <!-- Botón hamburguesa -->
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarContenido" aria-controls="navbarContenido" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Contenido -->
        <div class="collapse navbar-collapse" id="navbarContenido">

            <!-- Navegación principal -->
            <ul class="navbar-nav mr-auto">
                <li class="nav-item @(currentController == "Home" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Inicio</a>
                </li>
                <li class="nav-item @(currentController == "Hospedaje" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Hospedaje")"><i class="fas fa-bed"></i> Hospedajes</a>
                </li>
                <li class="nav-item @(currentController == "Experiencias" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Experiencias")"><i class="fas fa-globe-americas"></i> Experiencias</a>
                </li>
                <li class="nav-item @(currentController == "Servicios" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Servicios")"><i class="fas fa-concierge-bell"></i> Servicios</a>
                </li>
            </ul>

            <!-- Buscador -->
            <form class="form-inline my-2 my-lg-0 mx-lg-4" method="get" action="@Url.Action("Index", "Hospedaje")" style="max-width: 400px; width: 100%;">
                <div class="input-group w-100">
                    <input type="search"
                           name="q"
                           class="form-control border-0 shadow-sm rounded-start"
                           placeholder="¿A dónde vamos?"
                           aria-label="Buscar" />
                    <div class="input-group-append">
                        <button class="btn btn-light border shadow-sm rounded-end" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>


            <!-- Usuario -->
            <ul class="navbar-nav align-items-center ml-lg-auto">
                <li class="nav-item mx-2">
                    <a class="nav-link d-flex flex-column align-items-center" href="@Url.Action("BecomeHost", "Home")">
                        <i class="fas fa-door-open mb-1"></i>
                        <span style="font-size: 0.85rem; text-align: center;">Convertite en anfitrión</span>
                    </a>

                </li>
                <li class="nav-item mx-2">
                    <a class="nav-link" href="#"><i class="fas fa-globe"></i></a>
                </li>
                <li class="nav-item mx-2">
                    <a class="nav-link d-flex flex-column align-items-center" href="@Url.Action("Login", "Usuario")">
                        <i class="fas fa-user mb-1"></i>
                        Iniciar sesión
                    </a>
                </li>
            </ul>


        </div>
    </div>
</nav>
